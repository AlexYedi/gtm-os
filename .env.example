# gtm-os environment template — copy to .env and fill in.
# .env is gitignored; this file is the public reference for required keys.

# === HubSpot ===
# Private App token (HubSpot → Settings → Integrations → Private Apps).
# Required scopes: crm.objects.{contacts,companies,deals,notes}.{read,write},
# crm.objects.owners.read.
HUBSPOT_PRIVATE_APP_TOKEN=

# === n8n ===
# Self-hosted MCP token (JWT, aud=mcp-server-api). Generate in n8n at
# Settings → API → MCP Tokens. Bound to a specific n8n user.
N8N_MCP_TOKEN=
# Base URL of the n8n MCP server. For yedimaing.app.n8n.cloud the default is:
#   https://yedimaing.app.n8n.cloud/mcp
N8N_MCP_URL=

# === PostHog ===
# Personal API key (PostHog → Settings → Personal API Keys). Used by direct
# API fallback; the MCP itself uses OAuth and does not read this.
POSTHOG_API_KEY=

# === Supabase ===
# Service-role key for the gtm-os project (ref nnywrmetdoixdbevvsvf).
# Required scope: full DB access. Used by direct REST/SQL calls.
SUPABASE_GTM_OS_API_KEY=

# === Clay ===
# API key (Clay → Settings → API). Direct-API fallback when MCP is down.
CLAY_API_KEY=
