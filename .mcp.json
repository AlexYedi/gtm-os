{
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.notion.com/mcp"]
    },
    "hubspot": {
      "command": "npx",
      "args": [
        "-y",
        "dotenv-cli",
        "-e",
        "/Users/sameoldexpressions/Documents/GitHub/gtm-os/.env",
        "--",
        "npx",
        "-y",
        "@hubspot/mcp-server"
      ]
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "posthog": {
      "command": "npx",
      "args": [
        "-y",
        "dotenv-cli",
        "-e",
        "/Users/sameoldexpressions/Documents/GitHub/gtm-os/.env",
        "--",
        "sh",
        "-c",
        "exec npx -y mcp-remote https://mcp.posthog.com/mcp --header \"Authorization:Bearer $POSTHOG_API_KEY\""
      ]
    },
    "clay": {
      "command": "npx",
      "args": [
        "-y",
        "dotenv-cli",
        "-e",
        "/Users/sameoldexpressions/Documents/GitHub/gtm-os/.env",
        "--",
        "sh",
        "-c",
        "exec npx -y mcp-remote https://api.clay.com/v3/mcp --header \"Authorization:Bearer $CLAY_API_KEY\""
      ]
    },
    "granola": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.granola.ai/mcp"]
    },
    "google-calendar": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://gcal.mcp.claude.com/mcp"]
    },
    "gmail": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://gmail.mcp.claude.com/mcp"]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "dotenv-cli",
        "-e",
        "/Users/sameoldexpressions/Documents/GitHub/gtm-os/.env",
        "--",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ]
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.vercel.com"]
    },
    "n8n": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://yedimaing.app.n8n.cloud/mcp-server/http"]
    }
  }
}
